# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Pick a model with the ":free" suffix from https://openrouter.ai/models (the free list changes often).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Retrieval settings (defaults shown)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5